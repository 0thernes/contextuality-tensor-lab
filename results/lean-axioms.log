ContextualityTensor.square_minimum_closed_form (k : ℕ) :
  (∃ a, (ContextualityTensor.violations fun i => ContextualityTensor.squareResponse (a i)) = (7 ^ k - 5 ^ k) / 2) ∧
    ∀ (a : Fin k → Fin 9 → Bool),
      (7 ^ k - 5 ^ k) / 2 ≤ ContextualityTensor.violations fun i => ContextualityTensor.squareResponse (a i)
ContextualityTensor.pentagram_minimum_closed_form (k : ℕ) :
  (∃ a, (ContextualityTensor.violations fun i => ContextualityTensor.pentagramResponse (a i)) = (6 ^ k - 4 ^ k) / 2) ∧
    ∀ (a : Fin k → Fin 10 → Bool),
      (6 ^ k - 4 ^ k) / 2 ≤ ContextualityTensor.violations fun i => ContextualityTensor.pentagramResponse (a i)
ContextualityTensor.square_epsilon_tends_to_one : Filter.Tendsto ContextualityTensor.squareEpsilon Filter.atTop (nhds 1)
ContextualityTensor.pentagram_epsilon_tends_to_one :
  Filter.Tendsto ContextualityTensor.pentagramEpsilon Filter.atTop (nhds 1)
