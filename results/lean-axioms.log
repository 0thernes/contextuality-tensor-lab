ContextualityTensor.global_actual_square_minimum (k : ℕ) :
  (∃ a,
      ContextualityTensor.actualViolations ContextualityTensor.squareContext (fun c => c == 5) a =
        (7 ^ k - 5 ^ k) / 2) ∧
    ∀ (a : (_ : Fin k) × Fin 9 → Bool),
      (7 ^ k - 5 ^ k) / 2 ≤ ContextualityTensor.actualViolations ContextualityTensor.squareContext (fun c => c == 5) a
ContextualityTensor.global_actual_pentagram_minimum (k : ℕ) :
  (∃ a,
      ContextualityTensor.actualViolations ContextualityTensor.pentagramContext (fun c => c == 4) a =
        (6 ^ k - 4 ^ k) / 2) ∧
    ∀ (a : (_ : Fin k) × Fin 10 → Bool),
      (6 ^ k - 4 ^ k) / 2 ≤
        ContextualityTensor.actualViolations ContextualityTensor.pentagramContext (fun c => c == 4) a
